---
layout: layouts/base.njk
---
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/index.html">Home</a> / <a href="/writing.html">Writing</a> / <span aria-current="page">{{ post.title }}</span></nav>
<article>
  <header class="post-header"><h1 class="post-title">{{ post.title }}</h1><p class="post-meta"><time datetime="{{ post.date }}">{{ dateLabel }}</time></p>
    {% if post.pdf %}<a class="post-pdf-link" href="/{{ post.pdf }}">Download the full PDF ↓</a>{% endif %}
  </header>
  {% if headings.length %}<nav class="project-contents" aria-label="On this page"><h2>On this page</h2><ul>{% for heading in headings %}<li{% if heading.level == 'h3' %} class="contents-subsection"{% endif %}><a href="#{{ heading.id }}">{{ heading.title }}</a></li>{% endfor %}</ul></nav>{% endif %}
  <div class="post-body">{{ content | safe }}</div>
  <a class="back-link" href="/writing.html">← All writing</a>
</article>
<script src="{{ '/js/figure-viewer.js' | assetURL }}" defer></script>
