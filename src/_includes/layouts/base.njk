<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script>try{if(localStorage.getItem('theme')==='light')document.documentElement.dataset.theme='light';}catch(e){}</script>
  <title>{{ piece.title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="author" content="{{ site.name }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:type" content="{{ pageType or 'article' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ piece.title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ (socialImage or piece.thumbnail) | absoluteURL(site.site_url) }}">
  <meta property="og:image:alt" content="{{ piece.hero_slides[0].caption or piece.title }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ piece.title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ (socialImage or piece.thumbnail) | absoluteURL(site.site_url) }}">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/nav.css">
  <link rel="stylesheet" href="/css/case-file.css">
  <link rel="stylesheet" href="/css/static-project.css">
  {% for style in extraStyles %}<link rel="stylesheet" href="/css/{{ style }}">{% endfor %}
  {% if isWriting %}<link rel="alternate" type="application/rss+xml" title="Writing | {{ site.name }}" href="/feed.xml">{% endif %}
  {% if hasMath %}<link rel="stylesheet" href="/assets/vendor/katex/katex.min.css">{% endif %}
  {% if needsThree %}<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/"}}</script>{% endif %}
  <link rel="icon" href="/assets/favicon/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/assets/favicon/site.webmanifest">
  <script type="application/ld+json">{{ structuredData | safe }}</script>
</head>
<body data-static-project{% if isHome %} class="has-hero"{% endif %}>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {% include "partials/navigation.njk" %}
  <main id="main-content" class="page-container" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/js/static-project.js" defer></script>
  {% for script in scripts %}<script src="/js/{{ script }}" defer></script>{% endfor %}
</body>
</html>
