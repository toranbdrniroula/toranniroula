---
layout: layouts/base.njk
---
{% if isHome %}
<section class="hero">
  <flow-field cell-size="5" aria-hidden="true"></flow-field><div class="hero-scrim"></div>
  <div class="hero-copy">
    <span class="eyebrow">{{ site.hero.eyebrow }}</span><h1 class="hero-name">{{ site.name }}</h1>
    <p class="hero-intro">{{ site.hero.intro }}</p>
    <div class="hero-actions"><a class="hero-btn primary" href="/work.html">See the work →</a><a class="hero-btn" href="/{{ site.resume }}">Download CV</a><a class="hero-btn" href="/about.html">About</a></div>
  </div>
</section>
<div class="section-heading-row"><h2 class="section-heading">Selected work</h2><a class="back-link" href="/work.html">View all →</a></div>
{% else %}
<div class="section-heading-row"><h1 class="section-heading">{{ piece.title }}</h1></div>
<div class="tag-filter" data-index-filter hidden role="group" aria-label="Filter {{ kind }} by category">
  <button type="button" data-category="all" class="tag-filter-btn active" aria-pressed="true">All</button>
  {% for category in categories %}<button type="button" class="tag-filter-btn" data-category="{{ category.value }}" aria-pressed="false">{{ category.label }}</button>{% endfor %}
</div>
<p class="index-result-count" data-result-count aria-live="polite">{{ items.length }} {{ kind == 'writing' and 'posts' or 'projects' }}</p>
{% endif %}
<div class="{{ isWriting and 'writing-list' or 'gallery-grid' }}{% if isHome %} gallery-grid--selected{% endif %}" data-index-list>
{% for item in items %}
  {% if isWriting %}
  <a class="writing-entry{% if loop.index0 % 2 %} reverse{% endif %}" href="{{ item.href }}" data-index-item data-category="{{ item.category }}">
    {% if item.image %}<img class="writing-entry-thumb{% if item.image.animated %} animated-thumbnail{% endif %}" src="{{ item.image.src }}" alt="" width="{{ item.image.width }}" height="{{ item.image.height }}" loading="lazy" decoding="async">{% endif %}
    <div class="writing-entry-body"><h2 class="writing-entry-title">{{ item.title }}</h2><div class="writing-entry-meta"><time datetime="{{ item.date }}">{{ item.dateLabel }}</time> · {{ item.label }}</div><p class="writing-entry-excerpt">{{ item.excerpt }}</p><span class="writing-entry-link">Read →</span></div>
  </a>
  {% else %}
  <a class="gallery-tile{% if isHome and loop.first %} gallery-tile--lead{% endif %}" href="{{ item.href }}" data-index-item data-category="{{ item.category }}" aria-label="{{ item.title }}">
    <span class="card-media{% if item.thumbnail_fit == 'contain' %} card-media--contain{% endif %}">{% if item.image %}<img src="{{ item.image.src }}" alt="" width="{{ item.image.width }}" height="{{ item.image.height }}" loading="lazy" decoding="async">{% else %}<span class="thumbnail-fallback">{{ item.label }} · {{ item.date }}</span>{% endif %}</span>
    <span class="card-body">
      {% if isHome and loop.first %}<span class="card-feature-label">Featured project</span>{% endif %}
      <span class="card-meta"><span>{{ item.date }}</span><span class="card-status{% if item.statusClass == 'in-progress' %} card-status--active{% endif %}">{{ item.status }}</span></span>
      <span class="tile-title">{{ item.card_title or item.title }}</span>
      <span class="card-read" aria-hidden="true">Explore project <span>↗</span></span>
    </span>
  </a>
  {% endif %}
{% endfor %}
</div>
