---
layout: layouts/base.njk
---
<div class="media-gallery">
  <header class="gallery-intro">
    <p class="gallery-eyebrow">{{ gallery.eyebrow }}</p>
    <h1>{{ gallery.title }}</h1>
    <p class="gallery-lead">{{ gallery.description }}</p>
    {% if gallery.chapters.length %}<nav class="gallery-jump" aria-label="Gallery chapters">{% for chapter in gallery.chapters %}<a href="#{{ chapter.id }}">{{ chapter.title }} <span>{{ chapter.count }}</span></a>{% endfor %}</nav>{% endif %}
  </header>
  {% for chapter in gallery.chapters %}
  <section class="gallery-chapter" id="{{ chapter.id }}" aria-labelledby="{{ chapter.id }}-heading">
    <header class="gallery-chapter-header">
      <p class="gallery-eyebrow">Chapter {{ loop.index }} / {{ chapter.count }} pieces</p>
      <h2 id="{{ chapter.id }}-heading">{{ chapter.title }}</h2>
      {% if chapter.description %}<p>{{ chapter.description }}</p>{% endif %}
    </header>
    <div class="gallery-grid">
      {% for item in chapter.items %}
      <article class="gallery-card{% if item.featured %} gallery-featured{% endif %}{% if item.wide %} gallery-wide{% endif %}" id="{{ item.id }}">
        <figure>
          {% if item.still or item.src %}<div class="gallery-media"{% if item.width and item.height %} style="--media-ratio: {{ item.width }} / {{ item.height }}"{% endif %}>
          {% if item.type == 'video' and item.src %}
            <video controls playsinline preload="none"{% if item.poster %} poster="{{ item.poster }}"{% endif %}{% if item.width %} width="{{ item.width }}" height="{{ item.height }}"{% endif %} aria-label="{{ item.title }}">
              <source src="{{ item.src }}" type="video/mp4"><a href="{{ item.src }}">Watch {{ item.title }}</a>
            </video>
          {% else %}
            {% if item.type == 'image' %}<a href="{{ item.src }}" target="_blank" rel="noopener" aria-label="Open {{ item.title }} at full size">{% endif %}
            <img src="{{ item.still }}"{% if item.type == 'gif' %} data-gif="{{ item.src }}"{% endif %} alt="{{ item.alt or item.description }}" width="{{ item.width }}" height="{{ item.height }}" loading="lazy" decoding="async">
            {% if item.type == 'image' %}</a>{% endif %}
            {% if item.type == 'gif' %}<button type="button" class="gallery-play" aria-pressed="false" aria-label="Play {{ item.title }} GIF" hidden>Play GIF</button>{% endif %}
          {% endif %}
          </div>{% endif %}
          <figcaption>
            <p class="gallery-eyebrow">{% if item.subject %}{{ item.subject }} / {% endif %}{{ item.format }}</p>
            <h3>{{ item.title }}</h3>
            <p>{{ item.description }}</p>
            {% if item.date or item.software %}<p class="gallery-note">{% if item.date %}<span>{{ item.date }}</span>{% endif %}{% if item.date and item.software %} · {% endif %}{% if item.software %}<span>{{ item.software }}</span>{% endif %}</p>{% endif %}
            {% if item.tags.length %}<ul class="gallery-tags" aria-label="Tags">{% for tag in item.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
            {% if item.note %}<p class="gallery-note">{{ item.note }}</p>{% endif %}
            <div class="gallery-links">
              {% if item.type == 'gif' %}<a href="{{ item.src }}" target="_blank" rel="noopener">Open original GIF ↗</a>{% endif %}
              {% if item.sourceURL %}<a href="{{ item.sourceURL }}" target="_blank" rel="noopener">{{ item.sourceLabel or 'Open full recording' }} ↗</a>{% endif %}
              {% if item.projectURL %}<a href="{{ item.projectURL }}">{{ item.projectLabel or 'Read about this project' }} ↗</a>{% endif %}
            </div>
          </figcaption>
          {% if item.embedURL %}<details class="gallery-full"><summary>{{ item.embedLabel or 'Watch full recording' }}</summary><iframe data-src="{{ item.embedURL }}" title="{{ item.title }} — full recording" loading="lazy" allow="fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><p class="gallery-note">If the player is unavailable, <a href="{{ item.sourceURL }}" target="_blank" rel="noopener">open the recording directly</a>.</p></details>{% endif %}
        </figure>
      </article>
      {% endfor %}
    </div>
    {% if chapter.context %}<aside class="gallery-context"><h3>{{ chapter.context.title }}</h3><p>{{ chapter.context.text }}</p>{% if chapter.context.href %}<a href="{{ chapter.context.href }}">{{ chapter.context.label or 'Explore the research' }} ↗</a>{% endif %}</aside>{% endif %}
  </section>
  {% else %}<p>New work will appear here as it is ready to share.</p>{% endfor %}
</div>
