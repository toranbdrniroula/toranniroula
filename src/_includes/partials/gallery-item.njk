<article class="gallery-card{% if item.featured %} gallery-featured{% endif %}{% if item.wide %} gallery-wide{% endif %}{% if item.comparisonSide %} gallery-comparison-{{ item.comparisonSide }}{% endif %}" id="{{ item.id }}">
        <figure>
          {% if item.still or item.src %}<div class="gallery-media"{% if item.width and item.height %} style="--media-ratio: {{ item.width }} / {{ item.height }}"{% endif %}>
          {% if item.type == 'video' and item.src %}
            <video controls playsinline preload="none"{% if item.poster %} poster="{{ item.posterURL }}"{% endif %}{% if item.width %} width="{{ item.width }}" height="{{ item.height }}"{% endif %} aria-label="{{ item.title }}">
              <source src="{{ item.mediaSrcURL }}" type="video/mp4"><a href="{{ item.mediaSrcURL }}">Watch {{ item.title }}</a>
            </video>
          {% elif item.type == 'video' and item.embedURL %}
            <img src="{{ item.stillURL }}" alt="{{ item.title }}" width="{{ item.width }}" height="{{ item.height }}" loading="lazy" decoding="async">
            <button type="button" class="gallery-video-play" hidden aria-label="Play {{ item.title }}"><svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true" focusable="false"><rect class="gallery-play-background" width="68" height="48" rx="12"/><path fill="#fff" d="M28 14v20l18-10z"/></svg></button>
            <iframe class="gallery-video-frame" data-src="{{ item.embedURL }}" title="{{ item.title }}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen hidden></iframe>
          {% else %}
            {% if item.type == 'image' %}<a href="{{ item.mediaSrcURL }}" target="_blank" rel="noopener" aria-label="Open {{ item.title }} at full size">{% endif %}
            <img src="{{ item.stillURL }}"{% if item.type == 'gif' %} data-gif="{{ item.mediaSrcURL }}"{% endif %} alt="{{ item.alt or item.description }}" width="{{ item.width }}" height="{{ item.height }}" loading="lazy" decoding="async">
            {% if item.type == 'image' %}</a>{% endif %}
            {% if item.type == 'gif' %}<button type="button" class="gallery-play" aria-pressed="false" aria-label="Play {{ item.title }} GIF" hidden>Play GIF</button>{% endif %}
          {% endif %}
          </div>{% endif %}
          <figcaption>
            <p class="gallery-eyebrow">{% if item.subject %}{{ item.subject }} / {% endif %}{{ item.format }}</p>
            <h2>{{ item.title }}</h2>
            <p>{{ item.description }}</p>
            {% if item.date or item.software %}<p class="gallery-note">{% if item.date %}<span>{{ item.date }}</span>{% endif %}{% if item.date and item.software %} · {% endif %}{% if item.software %}<span>{{ item.software }}</span>{% endif %}</p>{% endif %}
            {% if item.tags.length %}<ul class="gallery-tags" aria-label="Tags">{% for tag in item.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
            {% if item.note %}<p class="gallery-note">{{ item.note }}</p>{% endif %}
            <div class="gallery-links">
              {% if item.type == 'gif' %}<a href="{{ item.mediaSrcURL }}" target="_blank" rel="noopener">Open original GIF ↗</a>{% endif %}
              {% if item.sourceURL %}<a href="{{ item.sourceURL }}" target="_blank" rel="noopener">{{ item.sourceLabel or 'Open full recording' }} ↗</a>{% endif %}
              {% if item.calibrationImage %}<a class="gallery-calibration" href="{{ item.calibrationURL }}" target="_blank" rel="noopener">Calibration curve ↗</a>{% endif %}
              {% if item.projectURL %}<a href="{{ item.projectURL }}">{{ item.projectLabel or 'Read about this project' }} ↗</a>{% endif %}
            </div>
          </figcaption>
          {% if item.embedURL and item.src %}<details class="gallery-full"><summary>{{ item.embedLabel or 'Watch full recording' }}</summary><iframe data-src="{{ item.embedURL }}" title="{{ item.title }} - full recording" loading="lazy" allow="fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><p class="gallery-note">If the player is unavailable, <a href="{{ item.sourceURL }}" target="_blank" rel="noopener">open the recording directly</a>.</p></details>{% endif %}
        </figure>
      </article>
