<div id="nav-scrim" class="nav-scrim"></div>
<header class="top-strip">
  <div class="identity">
    <a href="/index.html" class="name-mark">{{ site.name }}</a>
    <span class="signature-line">{{ site.signature_line }}</span>
  </div>
  <button id="nav-toggle" class="nav-toggle" type="button" aria-label="Open navigation" aria-controls="site-nav" aria-expanded="false" hidden>
    <span></span><span></span><span></span>
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Site navigation">
    {% for link in navigation %}<a href="{{ link.href }}"{% if link.active %} class="active" aria-current="page"{% endif %}>{{ link.label }}</a>{% endfor %}
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light theme" hidden>☽</button>
  </nav>
</header>
